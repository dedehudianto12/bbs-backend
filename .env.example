# ── App ──
APP_NAME=BBS Backend
APP_ENV=production

# Port (Railway sets PORT automatically)
PORT=8080

# ── Database ──
# Option A: Connection URL (Railway / Neon). Takes precedence over B.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Option B: Individual fields (used when DATABASE_URL is empty)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=bbs
# DB_SSLMODE=disable

# ── JWT ──
JWT_SECRET=change-me-to-a-random-string

# ── CORS ──
# Comma-separated allowed origins
CORS_ORIGINS=https://your-frontend.pages.dev

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
